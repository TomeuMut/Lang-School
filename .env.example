NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Vercel Supabase integration aliases are also supported at build time:
# SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# SUPABASE_PUBLISHABLE_KEY and legacy SUPABASE_ANON_KEY are public-key fallbacks.
# Never place secret/service-role/JWT keys or database passwords in public variables.
